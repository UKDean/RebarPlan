<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build only. TEAM_ID is filled in by the macos-appstore workflow. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Open and save the project and Excel files the user picks. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Required by WKWebView: inside the sandbox the web view stays blank
       without it, even though the app loads only its own bundled pages.
       The app itself makes no network requests. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>TEAM_ID.com.mashharawi.rebarplan</string>
  <key>com.apple.developer.team-identifier</key>
  <string>TEAM_ID</string>
</dict>
</plist>
