{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RebarPlan",
  "version": "1.0.0",
  "identifier": "com.mashharawi.rebarplan",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RebarPlan",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#121316"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Omar Mashharawi",
    "copyright": "© 2026 Omar Mashharawi. MIT licence.",
    "homepage": "https://mashharawi.com/tools/rebarplan/",
    "category": "Productivity",
    "shortDescription": "Bar bending schedule and rebar cutting optimiser",
    "longDescription": "RebarPlan turns a bar bending schedule into weights per diameter and an optimised cutting plan from stock bars. Arabic, English and Simplified Chinese.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    }
  }
}
