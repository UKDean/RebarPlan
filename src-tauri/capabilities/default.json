{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the RebarPlan window may do: file dialogs, reading and writing the files the user picks, opening links and the mail program.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }]
    },
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "mailto:*" }, { "url": "https://*" }]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
